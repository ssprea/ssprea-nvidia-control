<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ssprea_nvidia_control.Controls">
    <Design.PreviewWith>
    <controls:ResponsiveGrid Width="300" Height="150" Background="#222">
      <Border Background="#E74C3C"/>
      <Border Background="#27AE60"/>
      <Border Background="#2980B9"/>
    </controls:ResponsiveGrid>
  </Design.PreviewWith>

  <Styles.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="{x:Type controls:ResponsiveGrid}" TargetType="controls:ResponsiveGrid">

        <Setter Property="ItemsPanel">
          <ItemsPanelTemplate>
            <controls:ResponsivePanel />
          </ItemsPanelTemplate>
        </Setter>

        <Setter Property="Template">
          <ControlTemplate>
            <Grid ClipToBounds="True">
              <ItemsPresenter Name="PART_ItemsPresenter"
                               ItemsPanel="{TemplateBinding ItemsPanel}" />

              <Button Name="PART_PrevButton"
                      Content="&#8249;"
                      Classes="carousel-arrow"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsVisible="False" />

              <Button Name="PART_NextButton"
                      Content="&#8250;"
                      Classes="carousel-arrow"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      IsVisible="False" />
            </Grid>
          </ControlTemplate>
        </Setter>

        <!-- arrows only appear in narrow carousel mode -->
        <Style Selector="^:narrow /template/ Button#PART_PrevButton">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:narrow /template/ Button#PART_NextButton">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^ /template/ Button.carousel-arrow">
          <Setter Property="Width" Value="32" />
          <Setter Property="Height" Value="32" />
          <Setter Property="CornerRadius" Value="16" />
          <Setter Property="Background" Value="#AA000000" />
          <Setter Property="Foreground" Value="White" />
          <Setter Property="FontSize" Value="18" />
          <Setter Property="Margin" Value="8" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="ZIndex" Value="10" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
