<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ssprea_nvidia_control.Controls">
    <Design.PreviewWith>
        <controls:ResponsiveGridCarousel />
    </Design.PreviewWith>

    <Style Selector="controls|ResponsiveGridCarousel">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Grid Name="PART_Grid" />
                    <controls:NonVirtualizingCarousel ColumnDefinitions="*,10*,*" ClipToBounds="True" Name="PART_NVCarousel" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
