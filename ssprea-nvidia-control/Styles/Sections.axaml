<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ssprea_nvidia_control.Controls">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
        <Style Selector="Border.panelItem">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource SmallSectionBackgroundBrushLight}"/>
            
        </Style>
        
        <Style Selector="Border.panelItem Button">
            <Setter Property="Margin" Value="2"/>
        </Style>
        
        <Style Selector="Border.section, controls|CarousellableBorder.section">
            <Setter Property="Padding" Value="4,0,4,0"/>
        </Style>
    
        <Style Selector="Border.panelBar">
            <Setter Property="Background" Value="{DynamicResource SmallSectionBackgroundBrushLight}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="40,20,40,0"/>
            
        </Style>
    
        <Style Selector="Border.panelBar Button">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="40,0,40,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
                
        </Style>
    
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrushLight}"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    
        <Style Selector="controls|CarousellableBorder.lightSection">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrushLight}"/>
            
        </Style>
    
    <Style Selector="Border.lightSection">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrushLight}"/>
            
    </Style>
    
        <Style Selector="controls|CarousellableBorder:carouselled">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        
        <Style Selector="Border.flashing">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    </KeyFrame>
                    <KeyFrame Cue="25%">
                        <Setter Property="BorderBrush" Value="{DynamicResource StrongAccentBrush}"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    </KeyFrame>
                    <KeyFrame Cue="75%">
                        <Setter Property="BorderBrush" Value="{DynamicResource StrongAccentBrush}"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        
        <Style Selector="Grid.liveStatsPanel Label">
            <Setter Property="FontFamily" Value="{DynamicResource NotoSansMonoFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style Selector="Grid.liveStatsPanel ProgressBar">
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        
        <Style Selector="Grid.liveStatsPanel > Border">
            <Setter Property="BorderBrush" Value="{DynamicResource InfoBarsBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SmallSectionBackgroundBrushDark}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        
        <Style Selector="Grid.liveStatsPanel > Border:nth-child(8n+1), Grid.liveStatsPanel > Border:nth-child(8n+2), Grid.liveStatsPanel > Border:nth-child(8n+3), Grid.liveStatsPanel > Border:nth-child(8n+4)">
            <Setter Property="Background" Value="{DynamicResource SmallSectionBackgroundBrushLight}"/>
        </Style>
    
        
</Styles>
